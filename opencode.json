{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "AGENTS.md": "deny",
      "opencode.json": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "xcodebuild*": "allow",
      "scripts/verify.sh": "allow"
    },
    "external_directory": "ask"
  }
}
